```gitignore
# =========================
# Python
# =========================

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Python cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# =========================
# Environment / Secrets
# =========================

.env
.env.*
!.env.example

# =========================
# IDE / Editors
# =========================

.vscode/
.idea/
*.swp
*.swo

# =========================
# OS files
# =========================

.DS_Store
Thumbs.db

# =========================
# Build / Packaging
# =========================

build/
dist/
*.egg-info/
.eggs/

# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# =========================
# Logs
# =========================

*.log

# =========================
# Local databases / data
# =========================

*.db
*.sqlite
*.sqlite3

# =========================
# Temporary files
# =========================

*.tmp
*.temp
*.bak
```
